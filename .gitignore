# Что git пропускает - не попадает в коммиты и на GitHub.
# Правило: в git храним то, что нельзя получить заново (код, данные, описание).
# Всё, что программы создают или скачивают сами, - сюда.

# CodeGraph files
.codegraph/
.codegraph/**/*
**/.codegraph/

# Python создаёт сам при запуске
__pycache__/
*.pyc

# Сборка exe (PyInstaller): собирается заново командой сборки, весит десятки МБ
build/
dist/

# Данные пользователя программ: прогресс, настройки, кэш звука
user_data/

# Звук - скачивается или генерируется программами заново
*.mp3

# Временный файл расширения Code Runner (создаётся при запуске выделенного кода)
tempCodeRunnerFile.py
